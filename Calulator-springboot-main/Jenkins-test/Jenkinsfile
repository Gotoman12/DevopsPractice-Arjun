pipeline{
    agent { label 'pprod'}

    tools {
        jdk "java-17"
        maven "Maven"
    }

    stages{
        stage("git ckeckout"){
            steps{
                git url:"https://github.com/Gotoman12/DevopsPractice-Arjun.git",branch:'dev'
            }
        }
        stage("complie"){
            steps{
                dir('Calulator-springboot-main'){
                sh 'mvn compile'
                }
            }
        }
        stage("test"){
            steps{
                dir('Calulator-springboot-main'){
                sh 'mvn compile'
                }
            }
        }
         stage("package"){
            steps{
                dir('Calulator-springboot-main'){
                sh 'mvn clean package'
                }
            }
        }
    }
}